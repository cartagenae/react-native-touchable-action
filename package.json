{
  "name": "react-native-touchable-action",
  "version": "1.0.16",
  "description": "A simple floating action button component for any React Native project using Expo",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "author": "Eric Cartagena",
  "license": "MIT",
  "peerDependencies": {
    "react": "^19.0.0",
    "react-native": ">=0.83.10 <1.0.0"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1"
  },
  "keywords": [
    "react-native",
    "react-native-component",
    "react",
    "mobile-ui",
    "touchable",
    "touchable-action",
    "touchable-component",
    "pressable",
    "button",
    "interactive",
    "onPress",
    "gesture",
    "gesture-handler",
    "touch-feedback",
    "ios",
    "android",
    "cross-platform",
    "custom-button",
    "clickable"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:js": "babel src --extensions .ts,.tsx --out-dir dist",
    "build:types": "tsc --project tsconfig.json",
    "build": "npm run clean && npm run build:js && npm run build:types",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "react": "19.3.1",
    "react-native": "0.88.1",
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.2",
    "@babel/plugin-transform-modules-commonjs": "^8.1.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@types/react": "^19.3.0",
    "typescript": "^7.0.2"
  }
}
